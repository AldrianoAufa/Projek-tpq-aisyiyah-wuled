            <?php
            if ($tab == 'dashboard') {
                // Calendar Logic for SPP Harian

                // Generate list of valid months based on Academic Year & Semester
                $valid_months = [];
                if ($semester === 'ganjil') {
                    for ($m = 7; $m <= 12; $m++) $valid_months[] = ['m' => $m, 'y' => $ta_start];
                } elseif ($semester === 'genap') {
                    for ($m = 1; $m <= 6; $m++) $valid_months[] = ['m' => $m, 'y' => $ta_end];
                } else {
                    for ($m = 7; $m <= 12; $m++) $valid_months[] = ['m' => $m, 'y' => $ta_start];
                    for ($m = 1; $m <= 6; $m++) $valid_months[] = ['m' => $m, 'y' => $ta_end];
                }

                // Determine Selected Month/Year
                if (isset($_GET['month_year'])) {
                    $parts = explode('-', $_GET['month_year']);
                    $selected_month = (int)$parts[0];
                    $selected_year = (int)$parts[1];
                } else {
                    // Default to current month if in range, otherwise first valid month
                    $current_m = date('n');
                    $current_y = date('Y');
                    $found = false;
                    foreach ($valid_months as $vm) {
                        if ($vm['m'] == $current_m && $vm['y'] == $current_y) {
                            $found = true;
                            break;
                        }
                    }

                    if ($found) {
                        $selected_month = $current_m;
                        $selected_year = $current_y;
                    } else {
                        $selected_month = $valid_months[0]['m'];
                        $selected_year = $valid_months[0]['y'];
                    }
                }

                $days_in_month = cal_days_in_month(CAL_GREGORIAN, $selected_month, $selected_year);
                $month_name = date('F', mktime(0, 0, 0, $selected_month, 10));

                // Get paid dates for selected month
                $paid_dates = [];
                $result = $conn->query("SELECT DAY(tanggal) as day FROM pembayaran_spp_harian WHERE siswa_id = '$siswa_id' AND MONTH(tanggal) = '$selected_month' AND YEAR(tanggal) = '$selected_year'");
                while ($row = $result->fetch_assoc()) {
                    $paid_dates[] = $row['day'];
                }

                // Get holidays
                $holidays = [];
                $result = $conn->query("SELECT DAY(tanggal) as day, deskripsi FROM libur WHERE MONTH(tanggal) = '$selected_month' AND YEAR(tanggal) = '$selected_year'");
                while ($row = $result->fetch_assoc()) {
                    $holidays[$row['day']] = $row['deskripsi'];
                }
            ?>

                <!-- Filter Form - Tahun Ajaran, Semester, dan Bulan -->
                <form method="GET" class="mb-8 flex flex-col sm:flex-row gap-4 items-start sm:items-center bg-gray-50 p-4 rounded-xl border border-gray-100 flex-wrap">
